*.pt
*.onnx
*_openvino_model/
dist/
build/
*.zip

# Binario do MediaMTX (56 MB; baixado de github.com/bluenviron/mediamtx/releases)
tools/mediamtx/

# Relatorios forenses gerados pela aplicacao
spottingai_report_*.csv
sentinelai_report_*.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Cache do Python de arquivos estaticos servidos
