Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
.claude/
*.errors.txt

# Conjuntos de dados para avaliar/treinar modelos (baixados por tools/)
datasets/

# Configuracoes salvas pelo painel (estado local de cada maquina)
config/user_settings.json
config/user_settings.tmp

# Cache de compilacao do OpenVINO (gerado na 1a abertura de cada modelo)
ov_cache/

# Gravacoes do video do drone (tools / [tcp_h264] record_dir)
