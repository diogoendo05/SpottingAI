<?xml version="1.0" encoding="utf-8"?>
<!-- Gravando / fotos continuas: quadrado vermelho (toque para parar) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#66000000" />
            <stroke android:width="3dp" android:color="#FFE53935" />
        </shape>
    </item>
    <item android:bottom="20dp" android:left="20dp" android:right="20dp" android:top="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFE53935" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
