{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "memory": 3008,
      "maxDuration": 60,
      "includeFiles": "{src/**,static/**,sample_media/**,yolov8n.onnx}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
